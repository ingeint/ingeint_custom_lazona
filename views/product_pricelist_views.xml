<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ingeint_custom_lazona_product_pricelist_form_inherit" model="ir.ui.view">
        <field name="name">ingeint.custom.lazona.product.pricelist.form</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_list_related_id']" position="after">
                <field name="lazona_show_dual_currency"/>
                <field name="lazona_conversion_currency_id" invisible="not lazona_show_dual_currency" groups="base.group_multi_currency"/>
            </xpath>

            <xpath expr="//field[@name='item_ids']/tree[@editable='bottom']/field[@name='fixed_price']" position="after">
                <field name="lazona_price_display" string="Precio convertido" readonly="1" optional="show"/>
                <field name="lazona_price_status" readonly="1" optional="hide"/>
                <field name="lazona_price_currency_id" column_invisible="True"/>
                <field name="lazona_conversion_currency_id" column_invisible="True"/>
            </xpath>

            <xpath expr="//field[@name='item_ids']/tree[not(@editable)]/field[@name='price']" position="after">
                <field name="lazona_price_display" string="Precio convertido" readonly="1" optional="show"/>
                <field name="lazona_price_status" readonly="1" optional="hide"/>
                <field name="lazona_price_currency_id" column_invisible="True"/>
                <field name="lazona_conversion_currency_id" column_invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
