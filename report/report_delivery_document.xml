<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="lazona_report_delivery_document" inherit_id="stock.report_delivery_document" priority="80">
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-if="o.picking_type_id.code == 'incoming'" t-set="address" t-value="False"/>
            <t t-else="" t-set="address">
                <div name="div_outgoing_address">
                    <div name="outgoing_delivery_address" t-if="o.should_print_delivery_address()">
                        <span><strong>Dirección de entrega:</strong></span>
                        <div t-out="o.move_ids[0].partner_id or o.partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat_full"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                    <div name="outgoing_warehouse_address"
                         t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                        <span><strong>Almacén:</strong></span>
                        <div t-field="o.picking_type_id.warehouse_id.partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat_full"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-if="o.picking_type_id.code == 'incoming'" t-set="information_block" t-value="False"/>
            <t t-else="" t-set="information_block">
                <div class="row">
                    <div class="col-7" name="div_incoming_address">
                        <t t-set="show_partner" t-value="False"/>
                        <div name="customer_address" t-if="o.picking_type_id.code=='outgoing' and partner and partner != partner.commercial_partner_id">
                            <span><strong>Cliente:</strong></span>
                            <t t-set="show_partner" t-value="True"/>
                        </div>
                        <div t-if="show_partner" name="partner_header">
                            <div t-field="partner.commercial_partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat_full"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@class='page']/div[@class='oe_structure'][1]" position="after">
            <div t-if="o.picking_type_id.code == 'incoming'" class="row mt-3 mb-3">
                <div class="col-6">
                    <div class="border p-2 h-100">
                        <strong>PROVEEDOR</strong>
                        <div t-if="partner" t-field="partner.commercial_partner_id"
                             t-options='{"widget": "contact", "fields": ["name", "address", "phone", "vat_full"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border p-2 h-100">
                        <strong>ALMACÉN</strong>
                        <div t-if="o.picking_type_id.warehouse_id.partner_id" t-field="o.picking_type_id.warehouse_id.partner_id"
                             t-options='{"widget": "contact", "fields": ["name", "address", "phone", "vat_full"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>