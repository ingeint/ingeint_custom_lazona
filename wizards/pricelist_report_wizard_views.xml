<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lazona_pricelist_report_wizard_form" model="ir.ui.view">
        <field name="name">lazona.pricelist.report.wizard.form</field>
        <field name="model">lazona.pricelist.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de lista de precios">
                <group>
                    <group>
                        <field name="pricelist_id" options="{'no_create': True}"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                        <field name="date"/>
                        <field name="quantity"/>
                    </group>
                    <group>
                        <field name="show_conversion" invisible="not conversion_currency_id"/>
                        <field name="conversion_currency_id" invisible="not conversion_currency_id or not show_conversion"/>
                        <field name="show_stock"/>
                        <field name="only_available"/>
                        <field name="hide_zero_price"/>
                    </group>
                </group>
                <group string="Filtros">
                    <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="PDF" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" string="Excel" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lazona_pricelist_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de lista de precios</field>
        <field name="res_model">lazona.pricelist.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_pricelist"/>
        <field name="binding_view_types">form,list</field>
    </record>

    <menuitem id="menu_lazona_pricelist_report"
              name="Lista de precios"
              parent="sale.menu_sale_report"
              action="action_lazona_pricelist_report_wizard"
              groups="sales_team.group_sale_salesman"
              sequence="50"/>
</odoo>
